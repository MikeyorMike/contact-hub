[Unit]
Description=contact-hub address book
Documentation=https://github.com/your-name/contact-hub
After=network.target

[Service]
Type=simple
User=contact-hub
Group=contact-hub
WorkingDirectory=/opt/contact-hub
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/contact-hub
# 崩溃自动拉起
Restart=always
RestartSec=3
# 日志走 journald：journalctl -u contact-hub -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=contact-hub

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/contact-hub

[Install]
WantedBy=multi-user.target
